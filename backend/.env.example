# Copy to backend/.env for local development. Never commit real values.
# In AWS these come from ECS task definitions and AWS Secrets Manager.

NODE_ENV=development
PORT=4000

# `npm run db:dev` prints the local URL. In AWS: the RDS endpoint, with DB_SSL=true.
DATABASE_URL=
DB_POOL_MAX=10
DB_SSL=false

# At least 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=12
# Tablets (X-Client: tablet) work offline; their session lasts until they next sync.
REFRESH_TOKEN_TTL_TABLET_HOURS=720

# false only for http://localhost development
COOKIE_SECURE=false
# Only needed when the web app is served from another origin; the Vite dev server proxies /api instead.
CORS_ORIGINS=
# Number of proxies in front of the API (ALB + CloudFront = 2 in AWS)
TRUST_PROXY=0
LOG_LEVEL=info

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Optional: path to frontend/dist to serve the web app from the API (single container)
SERVE_WEB_DIST=

# Integrations: mock until the SAP / SAN-SIR / Windchill APIs are available.
SAP_MODE=mock
SAN_MODE=mock
SAP_SYNC_INTERVAL_MIN=15

# Photos and PDFs (local disk; an S3 adapter replaces this in AWS)
UPLOAD_DIR=
