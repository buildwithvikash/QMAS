# Copy to backend/.env for local development. Never commit real values.
# In AWS these come from ECS task definitions and AWS Secrets Manager.

NODE_ENV=development
PORT=4000

# `npm run db:dev` prints the local URL. In AWS: the RDS endpoint, with DB_SSL=true.
DATABASE_URL=
# Connections per API process. Keep (processes x DB_POOL_MAX + worker 4) below the server's max_connections.
DB_POOL_MAX=30
DB_SSL=false

# At least 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=12
# Tablets (X-Client: tablet) work offline; their session lasts until they next sync.
REFRESH_TOKEN_TTL_TABLET_HOURS=720

# false only for http://localhost development
COOKIE_SECURE=false
# Only needed when the web app is served from another origin; the Vite dev server proxies /api instead.
CORS_ORIGINS=
# Number of proxies in front of the API (ALB + CloudFront = 2 in AWS)
TRUST_PROXY=0
# Network access control (Administration → Network Access). Leave empty. Set to false only as a
# last resort, e.g. when the company ranges were saved wrongly and nobody can reach the admin page.
NETWORK_ACCESS_ENFORCE=
LOG_LEVEL=info
# Log files: one file per day per process (api-YYYY-MM-DD.log, worker-YYYY-MM-DD.log), JSON lines.
# In AWS set LOG_TO_FILE=false (CloudWatch collects stdout). LOG_DIR defaults to backend/logs.
LOG_TO_FILE=true
LOG_DIR=
LOG_FILE_DAYS=14

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# One sign-in per user: signing in on a new device signs the old one out (true / false).
SINGLE_SESSION=true
# Sign out after this many minutes without activity (0 = never). Tablet sessions are exempt.
IDLE_TIMEOUT_MIN=30

# Optional: path to frontend/dist to serve the web app from the API (single container)
SERVE_WEB_DIST=

# Integrations: mock until the SAP / SAN-SIR / Windchill APIs are available.
# SAP QA32 lots: mock = demo queue (load demo data with `npm run sap:demo -- <file.xlsx>`),
# api = the SAP API (records with the "SAP Data v1" fields; see src/integrations/sap/qa32.js).
SAP_MODE=mock
SAP_API_URL=
SAP_API_USER=
SAP_API_PASSWORD=
# Query parameter for "lots from this Start of Inspection date"
SAP_API_FROM_PARAM=from
# Days before the last Start of Inspection date asked again, for lots that reach SAP late (default 3)
SAP_API_OVERLAP_DAYS=3
# Lots taken per pull from the demo queue (default 5)
SAP_BATCH_SIZE=5
SAN_MODE=mock
SAP_SYNC_INTERVAL_MIN=15

# Photos and PDFs (local disk; an S3 adapter replaces this in AWS)
UPLOAD_DIR=

# Mail (notifications, CAPA reminders, "mail to myself"). 'log' keeps mail local; 'smtp' sends.
# In AWS use the SES SMTP endpoint; keep SMTP_USER / SMTP_PASS in Secrets Manager, never in git.
MAIL_TRANSPORT=log
MAIL_FROM=QMAS <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Testing only: deliver every mail to this address instead (subject names the intended recipient).
MAIL_REDIRECT_TO=
APP_BASE_URL=http://localhost:5173

