{
  "name": "@qmas/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:dev": "node --env-file-if-exists=.env scripts/dev-db.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@qmas/shared": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "supertest": "^7.3.0",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/linux-x64": "17.10.0-beta.17",
    "@embedded-postgres/windows-x64": "17.10.0-beta.17"
  }
}
