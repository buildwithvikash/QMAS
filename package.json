{
  "name": "qmas",
  "private": true,
  "description": "QMAS \u2014 Incoming Material Inspection (IMI) & Defect Notification (DN)",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm -w backend run dev",
    "dev:web": "npm -w frontend run dev",
    "db:migrate": "npm -w backend run db:migrate",
    "db:dev": "npm -w backend run db:dev",
    "create-admin": "npm -w backend run create-admin",
    "test": "npm -w @qmas/shared test && npm -w @qmas/backend test && npm -w @qmas/frontend test",
    "build:web": "npm -w frontend run build",
    "lint": "npm -w frontend run lint",
    "demo-users": "npm -w backend run demo-users",
    "check-mail": "npm -w backend run check-mail"
  }
}
